# Reserved for the Phase 3 live agent adapter. Leave blank until then.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Local development only. Compose reads this file explicitly via --env-file.
# Optional Docker administrator settings, never API/agent runtime credentials.
# The tested native local path is `make local-setup` (no Docker needed).
POSTGRES_DB=ecommerce_agent
POSTGRES_USER=ecommerce_local
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=54322
# `make api` loads only the restricted credential generated in var/runtime/api.env.
# Do not configure the API with the PostgreSQL administrator account.
